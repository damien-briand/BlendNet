# Locate the notices shipped with the Homebrew keg owning a library/header.
# Resolve /opt/homebrew/opt and include symlinks before walking up the keg.
function(blendnet_brew_notices source name_var files_var)
    set(${name_var} "" PARENT_SCOPE)
    set(${files_var} "" PARENT_SCOPE)
    if(NOT EXISTS "${source}")
        return()
    endif()
    file(REAL_PATH "${source}" _path)
    foreach(_level RANGE 0 12)
        if(EXISTS "${_path}/INSTALL_RECEIPT.json")
            get_filename_component(_version "${_path}" NAME)
            get_filename_component(_parent "${_path}" DIRECTORY)
            get_filename_component(_formula "${_parent}" NAME)
            file(GLOB _notices LIST_DIRECTORIES FALSE "${_path}/LICENSE*" "${_path}/COPYING*"
                "${_path}/NOTICE*" "${_path}/COPYRIGHT*")
            set(${name_var} "${_formula}-${_version}" PARENT_SCOPE)
            set(${files_var} "${_notices}" PARENT_SCOPE)
            return()
        endif()
        get_filename_component(_parent "${_path}" DIRECTORY)
        if(_parent STREQUAL _path)
            return()
        endif()
        set(_path "${_parent}")
    endforeach()
endfunction()
